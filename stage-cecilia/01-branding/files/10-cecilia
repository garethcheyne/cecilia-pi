#!/bin/sh
# Shown when someone signs in (on the screen or over SSH): what this Pi is,
# how Cecilia is doing, and where to open it.

VERSION=$(dpkg-query -W -f='${Version}' cecilia 2>/dev/null | sed 's/-[0-9]*$//')
if systemctl is-active --quiet cecilia; then
    STATE="running"
else
    STATE="not running (sudo systemctl status cecilia)"
fi
HOST=$(hostname)
ADDR=$(hostname -I 2>/dev/null | awk '{print $1}')

B=$(printf '\033[1m')
D=$(printf '\033[2m')
G=$(printf '\033[38;5;252m')
R=$(printf '\033[0m')

cat <<EOF

${G}        ▄${R}
${G}      ▄ █ ▄${R}
${G}    ▄ █ █ █ ▄${R}     ${B}Cecilia ${VERSION:-}${R}, ${STATE}
${G}    █ █ █ █ █${R}     Open http://${HOST}.local:7070${ADDR:+  or  http://${ADDR}:7070}
${D}    ▀▀▀▀▀▀▀▀▀${R}

  ${D}Cecilia keeps itself up to date (Settings, Updates). Useful commands:${R}
    sudo systemctl restart cecilia     ${D}restart it${R}
    journalctl -u cecilia -f           ${D}watch what it's doing${R}
    sudo nano /etc/default/cecilia     ${D}its settings${R}

EOF
